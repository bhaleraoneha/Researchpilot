# Any OpenAI-compatible provider that supports TOOL CALLING works. Copy to .env and fill in.
LLM_API_KEY=your_key_here
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
# Free options (leave LLM_BASE_URL empty for OpenAI itself):
#   Groq:   LLM_BASE_URL=https://api.groq.com/openai/v1                              LLM_MODEL=llama-3.3-70b-versatile
#   Gemini: LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/    LLM_MODEL=gemini-2.0-flash
# (If a model name is retired, pick a current tool-calling model from the provider's docs.)
